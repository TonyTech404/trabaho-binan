# Dependencies
/node_modules/

# Build output and generated types
/build/
/.react-router/
*.tsbuildinfo
worker-configuration.d.ts

# Cloudflare local state
.mf
.wrangler
.dev.vars*
!.dev.vars.example

# Environment and secrets — never commit real credentials
.env
.env.*
!.env.example
/.secrets/
*.pem
*.key

# Database dumps and backups (may contain personal data)
*.dump
*.sql.gz
*.sql.gpg
*.dump.gpg
/backups/

# Test output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/coverage/

# Local tooling
/.local/
.DS_Store
*.log
.vscode/*
!.vscode/extensions.json
.idea/

# Playwright MCP session artefacts
/.playwright-mcp/

# Playwright signed-in state for tests
/playwright/.auth/
