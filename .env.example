# Local development and test settings (copy to .env). Placeholders only — never commit real values.
# Worker secrets for `npm run dev` go in .dev.vars (see .dev.vars.example).

# The local Worker reaches PostgreSQL through its Hyperdrive binding using this connection string.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://USER:PASSWORD@localhost:5432/trabaho_dev

# Migrations, seeding and maintenance scripts (database owner role).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/trabaho_dev

# Vitest integration tests. The database is dropped and rebuilt on every run.
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/trabaho_test
# Optional: a restricted runtime role on the test database, to test the grant script.
TEST_APP_ROLE_DATABASE_URL=postgres://trabaho_app:PASSWORD@localhost:5432/trabaho_test

# Playwright end-to-end tests. The database is dropped, migrated and seeded on every run.
E2E_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/trabaho_e2e
E2E_APP_DATABASE_URL=postgres://trabaho_app:PASSWORD@localhost:5432/trabaho_e2e
